# 数据库连接（Nitro 运行时通过 NUXT_ 前缀覆盖 runtimeConfig）
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=my2077
NUXT_DB_PASS=change-me
NUXT_DB_NAME=my2077

# 会话密钥（请替换为随机字符串）
NUXT_SESSION_SECRET=please-change-to-random

# 站点地址
NUXT_PUBLIC_SITE_URL=https://my2077.com

# 服务监听端口
PORT=3100

# 搜索引擎主动推送（IndexNow 无需配置；百度需在站长平台获取 token）
# BAIDU_PUSH_TOKEN=

# 可选：GitHub API Token 兜底（推荐在后台「引擎设置 → GitHub Token」填写，后台配置优先）
# 每个 Token 独立 5,000 次/小时；未配置时匿名额度仅 60 次/小时
# GITHUB_TOKEN=
# 可选：多个 GitHub Token，逗号分隔，会自动轮询以分摊 API 限额
# GITHUB_TOKENS=
# 可选：第三方中转兜底（后台引擎设置留空时生效；不会向第三方发送 Token）
# GITHUB_SEARCH_RELAYS=https://gh-proxy.com,https://gh-proxy.org,https://gh.llkk.cc,https://ghproxy.icu
