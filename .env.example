# 数据库连接（Nitro 运行时通过 NUXT_ 前缀覆盖 runtimeConfig）
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=my2077
NUXT_DB_PASS=change-me
NUXT_DB_NAME=my2077

# 会话密钥（请替换为随机字符串）
NUXT_SESSION_SECRET=please-change-to-random

# 站点地址
NUXT_PUBLIC_SITE_URL=https://my2077.com

# 服务监听端口
PORT=3100

# 搜索引擎主动推送（IndexNow 无需配置；百度需在站长平台获取 token）
# BAIDU_PUSH_TOKEN=

# 可选：GitHub API Token（配置后搜索/Release 额度更高；不配置也能用）
# GITHUB_TOKEN=
# 可选：多个 GitHub Token，逗号分隔，会自动轮询以分摊 API 限额
# GITHUB_TOKENS=
# 可选：第三方搜索中转（逗号分隔，官方接口受限时按顺序降级；不会向第三方发送 Token）
# GITHUB_SEARCH_RELAYS=https://gh-proxy.com,https://gh.llkk.cc
